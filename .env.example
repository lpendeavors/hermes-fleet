# Kimi (Moonshot AI) LLM Provider
KIMI_API_KEY=your-kimi-api-key-here

# Discord Bot
DISCORD_TOKEN=your-discord-bot-token-here

# Firecrawl Self-Hosted (no API key needed - runs locally)
FIRECRAWL_API_URL=http://firecrawl-api:3002

# VPS Deployment (for GitHub Actions)
VPS_HOST=your-vps-ip-or-hostname
VPS_USER=your-ssh-username
VPS_PASSWORD=your-ssh-password

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
